{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-medallion-api",
  "account_id": "25eb8d3849be3adbff3678f4ec781804",
  "main": "edge/worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "destinations": [
        "astro-grafana-logs"
      ],
      "persist": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": [
        "astro-grafana-traces"
      ],
      "persist": false
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2004ed1dbe4a460495e663c42f3b801f"
    }
  ],
  "build": {
    "command": "node edge/build.mjs"
  },
  "vars": {
    "RATE_LIMIT_PER_MINUTE": "120",
    "SNAPSHOT_TTL_SECONDS": "3600",
    "MAX_SNAPSHOT_ROWS": "100000",
    "RETRY_AFTER_SECONDS": "5"
  }
}
