# Não coloque valores reais neste arquivo.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
API_TOKEN=replace-with-a-random-64-character-token
# CA privada do provedor, PEM com quebras de linha escapadas como \n.
DATABASE_SSL_CA=
# Alternativa local: caminho para o arquivo CA (não configurar ambas as opções).
# DATABASE_SSL_CA_FILE=C:/certificados/aiven-ca.pem

# Controle persistente: requer migrations/001_history_and_snapshots.sql.
RATE_LIMIT_PER_MINUTE=120
SNAPSHOT_TTL_SECONDS=3600
MAX_SNAPSHOT_ROWS=100000
RETRY_AFTER_SECONDS=5
